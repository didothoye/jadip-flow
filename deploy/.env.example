# Copier en deploy/.env sur le VPS (chmod 600). Ne jamais versionner.
JADIP_FLOW_VERSION=latest
NODE_ENV=production
PUBLIC_URL=https://flow.jadipservices.com
COOKIE_SECURE=true
APP_TIMEZONE=Africa/Kinshasa
# openssl rand -hex 24  — rôle propriétaire (migrations ; caractères hexadécimaux pour l’URL)
POSTGRES_PASSWORD=
# openssl rand -hex 24  — mot de passe du rôle applicatif restreint (caractères hexadécimaux uniquement)
APP_DB_PASSWORD=
# openssl rand -base64 32  — clé maîtresse de chiffrement des clés API (à sauvegarder hors serveur !)
APP_ENCRYPTION_KEY=
# E-mail (Zoho)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Jadip Flow <notifications@jadipservices.com>
ADMIN_NOTIFY_EMAIL=
# Telegram (facultatif) : valeurs initiales seulement, reprises en base au premier démarrage.
# Ensuite, le compte se gère dans Paramètres › Alertes Telegram (la base fait foi).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Démonstration (facultatif)
DEMO_N8N_KEY=
