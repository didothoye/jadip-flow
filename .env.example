# Jadip Flow — variables d'environnement (copier en .env sur le serveur, ne jamais versionner le .env)
NODE_ENV=production
PORT=3000
PUBLIC_URL=https://flow.jadipservices.com
COOKIE_SECURE=true
APP_TIMEZONE=Africa/Kinshasa

# PostgreSQL (conteneur dédié)
POSTGRES_PASSWORD=
DATABASE_URL=postgres://jadip_flow:${POSTGRES_PASSWORD}@jadip-flow-db:5432/jadip_flow

# Clé maîtresse AES-256 pour chiffrer les clés API au repos : openssl rand -base64 32
APP_ENCRYPTION_KEY=

# E-mail (Zoho)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Jadip Flow <notifications@jadipservices.com>
ADMIN_NOTIFY_EMAIL=

# Telegram (facultatif) : valeurs initiales seulement, reprises en base au premier démarrage.
# Ensuite, le compte se gère dans Paramètres › Alertes Telegram (la base fait foi).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
